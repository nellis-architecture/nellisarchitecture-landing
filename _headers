# X-Robots-Tag: noindex keeps workers.dev out of search. Remove it at the DNS cutover (card 9).
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex

# One cache rule per root under wp-content/. Do not add a /wp-content/* rule: Cloudflare
# joins a header that two matching rules both set. uploads/ and variants/ keep their names
# (AGENTS.md); themes/ and plugins/ are edited in place, their URLs carry no version.
/wp-content/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/wp-content/variants/*
  Cache-Control: public, max-age=31536000, immutable

/wp-content/themes/*
  Cache-Control: public, max-age=0, must-revalidate

/wp-content/plugins/*
  Cache-Control: public, max-age=0, must-revalidate
