/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# workers.dev stays on for checks and rollback, but out of search (LND-052).
https://landing.nellisarchitecture.workers.dev/*
  X-Robots-Tag: noindex

# One cache rule per root under wp-content/. Do not add a /wp-content/* rule: Cloudflare
# joins a header that two matching rules both set. uploads/ and variants/ keep their names
# (AGENTS.md); themes/ and plugins/ are edited in place, their URLs carry no version.
/wp-content/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/wp-content/variants/*
  Cache-Control: public, max-age=31536000, immutable

/wp-content/themes/*
  Cache-Control: public, max-age=0, must-revalidate

/wp-content/plugins/*
  Cache-Control: public, max-age=0, must-revalidate
