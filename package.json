{
  "name": "nellis-architecture-static",
  "version": "1.0.0",
  "private": true,
  "description": "Static build of nellisarchitecture.com with Decap CMS for news",
  "scripts": {
    "build": "node build-news.js",
    "images": "node build/make-images.js",
    "serve": "serve -l 8000",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "test": "node --test",
    "test:browser": "node browser/run.js",
    "test:browser-visible": "HEADED=1 node browser/run.js",
    "cms": "decap-server",
    "deploy": "node infra/lifecycle.js && npx --yes wrangler@4.151.0 deploy",
    "infra": "node infra/cloudflare.js"
  },
  "devDependencies": {
    "decap-server": "^3.11.3",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "serve": "^14.2.6",
    "sharp": "0.35.5",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=20"
  }
}
